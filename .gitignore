# macOS / editor noise
.DS_Store
**/.DS_Store
.playwright-cli/

# Handoff / archives
*.zip
*.tar
*.tar.gz
*.tgz

# Raw or oversized media sources
*.heic
*.HEIC
*.mov
*.MOV
*.avi
*.mkv
*.psd
*.ai

# Legacy export folders and duplicate source material
assets/Colors/
assets/Fotos/Kathi_*.png
assets/Icons/BRANDING KIT_profile image 2 copy*.png
yoga-kathi/

# Keep web-ready images, logos, icons, fonts, and future optimized videos trackable.
!assets/photos/*.jpg
!assets/photos/*.webp
!assets/logos/*.png
!assets/icons/icon-*.png
!assets/fonts/*
!assets/images/*
!assets/videos/*.mp4
!assets/videos/*.webm

# Source-size photo PNGs stay local; optimized JPEG/WebP variants are tracked.
assets/photos/*.png

# Ignore verbose legacy logo exports while keeping normalized logo-*.png files.
assets/logos/Logo_*

# impeccable-ignore-start
# Ephemeral output, runtime state, and per-developer overrides.
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/*.png
.impeccable/live/server.json
.impeccable/live/sessions/
.impeccable/live/previews/
.impeccable/live/annotations/
.impeccable/live/cache/
.impeccable/live/manual-edit-apply-transaction.json
.impeccable/live/manual-edit-events.jsonl
.impeccable/live/manual-edit-evidence/
.impeccable/live/pending-manual-edits.json
.impeccable/live/deferred-svelte-component-accepts.json
.impeccable/live/*.png
# impeccable-ignore-end

# Local Codex runtime and project-only agent configuration.
.agents/
.codex/

# Local visual QA captures and duplicated source-photo crops.
.impeccable/review/
.impeccable/mocks/source-ref/
.impeccable/design.json
.impeccable/index-surface-brief.md
